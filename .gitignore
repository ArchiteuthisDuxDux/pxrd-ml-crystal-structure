*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and package builds
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Editors and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local machine paths and secrets
/config/raw_sources.json
.env
.env.*
!.env.example

# Raw and generated datasets. These are rebuilt by notebooks 02-06.
/data/
*.parquet
*.feather
*.arrow
*.npy
*.npz
*.f16
*.u8
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib

# Model binaries are generated by the training notebooks.
/checkpoints/
*.pt
*.pth
*.ckpt
*.onnx

# Large or transient output artifacts. Compact metric/config CSV and JSON files
# under outputs/ remain trackable as evidence for the README.
/outputs/_tmp_*
/outputs/*.png
/outputs/*_oof_predictions.csv
/outputs/splits_*.parquet
/outputs/synth_done_*.txt
/outputs/synth_skipped_*.log
/outputs/synth_manifest_*.json

# Diagnostic feature caches created from preprocessed arrays
/src/outputs/

# Bulk reports are reproducible; curated GitHub figures live in docs/assets/readme/.
/reports/

# Training logs and experiment trackers
/logs/
/runs/
/wandb/
*.log

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
~$*

/presentation/
*.pptx